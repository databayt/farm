{
  "name": "farm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docs:sync": "node scripts/sync-docs.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/sync-docs.mjs && fumadocs-mdx",
    "build:cf": "node scripts/sync-docs.mjs && CF_STATIC=1 next build",
    "deploy:cf": "pnpm build:cf && wrangler deploy",
    "studio:build": "uv run --with-requirements scripts/studio/requirements.txt python scripts/studio/build.py",
    "site:refs": "node scripts/site/refs.mjs",
    "site:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/site/build-assets.mjs",
    "site:hero": "node scripts/site/hero.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "front-matter": "^4.0.2",
    "fumadocs-core": "16.0.5",
    "fumadocs-mdx": "13.0.2",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  },
  "packageManager": "pnpm@10.24.0"
}
